---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;

const nav = [
	{ href: '/admin', label: '概览', match: (p: string) => p === '/admin' || p === '/admin/' },
	{ href: '/admin/profile', label: '个人信息', match: (p: string) => p.startsWith('/admin/profile') },
	{ href: '/admin/movies', label: '电影管理', match: (p: string) => p.startsWith('/admin/movies') },
	{ href: '/admin/projects', label: '作品管理', match: (p: string) => p.startsWith('/admin/projects') },
	{ href: '/admin/skills', label: '技能管理', match: (p: string) => p.startsWith('/admin/skills') },
	{ href: '/admin/timeline', label: '经历管理', match: (p: string) => p.startsWith('/admin/timeline') },
	{ href: '/admin/settings', label: '设置', match: (p: string) => p.startsWith('/admin/settings') },
];
---

<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title} · 管理后台</title>
		<meta name="robots" content="noindex,nofollow" />
	</head>
	<body class="min-h-screen bg-[var(--color-surface-muted)] text-foreground antialiased">
		<div class="flex min-h-screen">
			<aside class="flex w-56 shrink-0 flex-col border-r border-border bg-surface">
				<div class="flex items-center gap-2.5 border-b border-border px-5 py-5">
					<span class="flex h-8 w-8 items-center justify-center rounded-lg bg-accent text-sm font-bold text-white"
						>D</span
					>
					<div>
						<p class="text-sm font-semibold">管理后台</p>
						<p class="text-[11px] text-muted">Dewy CMS</p>
					</div>
				</div>
				<nav class="flex flex-1 flex-col gap-0.5 p-3">
					{
						nav.map((item) => (
							<a
								href={item.href}
								class:list={[
									'rounded-lg px-3 py-2 text-sm transition-colors',
									item.match(path)
										? 'bg-accent-soft font-medium text-accent'
										: 'text-muted hover:bg-surface-muted hover:text-foreground',
								]}
							>
								{item.label}
							</a>
						))
					}
				</nav>
				<div class="border-t border-border p-3">
					<a href="/" target="_blank" class="block rounded-lg px-3 py-2 text-sm text-muted hover:text-accent"
						>查看网站 ↗</a
					>
					<form method="POST" action="/api/admin/logout">
						<button type="submit" class="w-full rounded-lg px-3 py-2 text-left text-sm text-muted hover:text-accent">
							退出登录
						</button>
					</form>
				</div>
			</aside>

			<main class="min-w-0 flex-1">
				<header class="border-b border-border bg-surface px-8 py-5">
					<h1 class="text-xl font-semibold tracking-tight">{title}</h1>
					{description && <p class="mt-1 text-sm text-muted">{description}</p>}
				</header>
				<div class="px-8 py-8">
					<slot />
				</div>
			</main>
		</div>
	</body>
</html>
