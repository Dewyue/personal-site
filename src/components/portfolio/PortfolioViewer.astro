---
import { portfolioMeta, portfolioPages, portfolioProjects as zhProjects } from '../../data/portfolio';
import { enProjects } from '../../i18n/content/en';
import { getUi, resolveLocale, type Locale } from '../../i18n';

interface Props {
	/** 初始页码，从 1 开始 */
	initialPage?: number;
	class?: string;
	locale?: Locale;
	/** embedded：嵌在精选作品下方，弱化展示；standalone：独立作品页 */
	variant?: 'embedded' | 'standalone';
}

const { initialPage = 1, class: className, variant = 'standalone' } = Astro.props;
const locale = resolveLocale(Astro.props.locale ?? Astro.currentLocale);
const t = getUi(locale).projects;
const projects = locale === 'en' ? enProjects : [...zhProjects];
const pages = [...portfolioPages];
const resolvedInitial = pages.includes(initialPage)
	? initialPage
	: pages.reduce((best, n) => (Math.abs(n - initialPage) < Math.abs(best - initialPage) ? n : best), pages[0]);
const initialDisplay = pages.indexOf(resolvedInitial) + 1;
const projectsJson = JSON.stringify(
	projects.map((p) => ({
		number: p.number,
		title: p.title,
		startPage: p.startPage,
		endPage: p.endPage,
	})),
);
const embedded = variant === 'embedded';
---

<section
	id="portfolio"
	class:list={[
		'portfolio-viewer scroll-mt-20',
		embedded ? 'bg-transparent' : 'band-ink',
		className,
	]}
	data-total={portfolioMeta.totalPages}
	data-initial={resolvedInitial}
	data-page-list={JSON.stringify(pages)}
	data-fallback-caption={t.fallbackCaption}
	data-projects={projectsJson}
>
	<div class:list={['mx-auto max-w-6xl px-4 sm:px-6', embedded ? 'pb-16 pt-2 sm:pb-24' : 'py-16 sm:py-24']}>
		{
			!embedded && (
				<div class="reveal mb-8 sm:mb-10">
					<p class="section-index mb-3">Portfolio · {portfolioMeta.totalPages} Pages</p>
					<h2 class="display-title text-3xl sm:text-4xl">{t.viewerHeadline}</h2>
					<p class="mt-3 max-w-xl text-sm leading-relaxed text-[var(--color-on-ink-muted)]">
						{t.viewerIntro}
					</p>
				</div>
			)
		}

		<div
			class:list={[
				'reveal overflow-hidden rounded-[1.5rem] shadow-[0_30px_60px_-24px_rgba(0,0,0,0.55)] ring-1',
				embedded
					? 'bg-surface-muted ring-black/5'
					: 'bg-[var(--color-on-ink-card)] ring-white/5',
			]}
		>
			{/* 项目跳转收进框顶，不再单独占一整行大卡 */}
			<div
				class:list={[
					'flex gap-2 overflow-x-auto border-b px-3 py-3 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:px-4',
					embedded ? 'border-black/5' : 'border-white/5',
				]}
			>
				{
					projects.map((project) => (
						<button
							type="button"
							class:list={[
								'project-jump shrink-0 rounded-full px-3 py-1.5 text-left transition',
								embedded
									? 'bg-surface text-foreground hover:bg-surface ring-1 ring-border'
									: 'bg-white/5 text-[var(--color-on-ink)] hover:bg-white/10',
							]}
							data-page={project.startPage}
							aria-label={t.jumpTo(project.title)}
						>
							<span class="text-[11px] font-semibold tracking-wider text-accent">{project.number}</span>
							<span
								class:list={[
									'ml-1.5 text-xs font-medium',
									embedded ? 'text-foreground' : 'text-[var(--color-on-ink)]',
								]}
							>
								{project.title}
							</span>
						</button>
					))
				}
			</div>

			<div class="portfolio-stage relative aspect-[16/9] bg-black">
				{
					pages.map((n) => (
						<img
							src={portfolioMeta.pagePath(n)}
							alt={t.pageAlt(pages.indexOf(n) + 1)}
							class:list={[
								'portfolio-page absolute inset-0 h-full w-full object-contain',
								n === resolvedInitial ? 'is-active' : '',
							]}
							data-page={n}
							loading={n <= 4 ? 'eager' : 'lazy'}
							decoding="async"
						/>
					))
				}

				<button
					type="button"
					class="portfolio-prev absolute left-3 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-black/45 text-white backdrop-blur-md transition hover:bg-black/65 sm:left-5"
					aria-label={t.prev}
				>
					<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
					</svg>
				</button>
				<button
					type="button"
					class="portfolio-next absolute right-3 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-black/45 text-white backdrop-blur-md transition hover:bg-black/65 sm:right-5"
					aria-label={t.next}
				>
					<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
					</svg>
				</button>
			</div>

			<div
				class:list={[
					'flex items-center justify-between gap-4 border-t px-4 py-3 sm:px-5',
					embedded ? 'border-black/5' : 'border-white/5',
				]}
			>
				<p
					class:list={[
						'text-sm',
						embedded ? 'text-muted' : 'text-[var(--color-on-ink-muted)]',
					]}
				>
					<span
						class:list={[
							'portfolio-current font-semibold',
							embedded ? 'text-foreground' : 'text-[var(--color-on-ink)]',
						]}
					>
						{initialDisplay}
					</span>
					<span class="mx-1">/</span>
					<span>{portfolioMeta.totalPages}</span>
					<span
						class:list={[
							'portfolio-caption ml-3 hidden sm:inline',
							embedded ? 'text-muted' : 'text-[var(--color-on-ink-muted)]',
						]}
					></span>
				</p>
				<div class="flex gap-2">
					<button
						type="button"
						class:list={[
							'portfolio-prev rounded-full px-3.5 py-1.5 text-xs font-medium',
							embedded
								? 'bg-black/5 text-foreground hover:bg-black/10'
								: 'bg-white/5 text-[var(--color-on-ink)] hover:bg-white/10',
						]}
					>
						{t.prev}
					</button>
					<button
						type="button"
						class="portfolio-next rounded-full bg-accent px-3.5 py-1.5 text-xs font-semibold text-white hover:bg-accent-hover"
					>
						{t.next}
					</button>
				</div>
			</div>
		</div>

		<div
			class="portfolio-thumbs reveal mt-4 flex gap-2 overflow-x-auto pb-1 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
			role="tablist"
			aria-label={t.thumbsAria}
		>
			{
				pages.map((n) => (
					<button
						type="button"
						class:list={[
							'portfolio-thumb shrink-0 overflow-hidden rounded-md ring-2 transition',
							n === resolvedInitial ? 'ring-accent' : 'ring-transparent opacity-50 hover:opacity-100',
						]}
						data-page={n}
						aria-label={t.pageAria(pages.indexOf(n) + 1)}
						aria-current={n === resolvedInitial ? 'true' : undefined}
					>
						<img
							src={portfolioMeta.pagePath(n)}
							alt=""
							class="h-11 w-[78px] object-cover sm:h-12 sm:w-[86px]"
							loading="lazy"
							decoding="async"
						/>
					</button>
				))
			}
		</div>

		{
			embedded && (
				<p class="reveal mt-3 text-center text-xs text-muted">{t.viewerIntro}</p>
			)
		}
	</div>
</section>

<script>
	type ProjectMeta = { number: string; title: string; startPage: number; endPage: number };

	function initPortfolioViewer(root: HTMLElement) {
		let pageList: number[] = [];
		try {
			pageList = JSON.parse(root.dataset.pageList || '[]') as number[];
		} catch {
			pageList = [];
		}
		if (!pageList.length) {
			const total = Number(root.dataset.total || 30);
			pageList = Array.from({ length: total }, (_, i) => i + 1);
		}
		let current = Number(root.dataset.initial || pageList[0] || 1);
		const fallbackCaption = root.dataset.fallbackCaption || 'Portfolio';
		let projects: ProjectMeta[] = [];
		try {
			projects = JSON.parse(root.dataset.projects || '[]') as ProjectMeta[];
		} catch {
			projects = [];
		}

		function nearestPage(page: number) {
			if (pageList.includes(page)) return page;
			return pageList.reduce((best, n) => (Math.abs(n - page) < Math.abs(best - page) ? n : best), pageList[0]);
		}

		function displayOf(page: number) {
			const i = pageList.indexOf(page);
			return i >= 0 ? i + 1 : 1;
		}

		function step(delta: number) {
			const i = pageList.indexOf(current);
			const next = pageList[i + delta];
			if (next != null) go(next);
		}

		const pages = root.querySelectorAll<HTMLImageElement>('.portfolio-page');
		const thumbs = root.querySelectorAll<HTMLButtonElement>('.portfolio-thumb');
		const thumbStrip = root.querySelector<HTMLElement>('.portfolio-thumbs');
		const currentEl = root.querySelector<HTMLElement>('.portfolio-current');
		const captionEl = root.querySelector<HTMLElement>('.portfolio-caption');
		const prevBtns = root.querySelectorAll('.portfolio-prev');
		const nextBtns = root.querySelectorAll('.portfolio-next');
		const jumps = root.querySelectorAll<HTMLButtonElement>('.project-jump');

		function captionFor(page: number) {
			const project = projects.find((p) => page >= p.startPage && page <= p.endPage);
			return project ? `${project.number} · ${project.title}` : fallbackCaption;
		}

		function centerThumb(thumb: HTMLElement) {
			if (!thumbStrip) return;
			const left = thumb.offsetLeft - (thumbStrip.clientWidth - thumb.clientWidth) / 2;
			thumbStrip.scrollTo({ left: Math.max(0, left), behavior: 'smooth' });
		}

		function go(page: number, opts: { syncThumb?: boolean } = {}) {
			const { syncThumb = true } = opts;
			current = nearestPage(page);
			pages.forEach((img) => {
				img.classList.toggle('is-active', Number(img.dataset.page) === current);
			});
			thumbs.forEach((thumb) => {
				const active = Number(thumb.dataset.page) === current;
				thumb.classList.toggle('ring-accent', active);
				thumb.classList.toggle('ring-transparent', !active);
				thumb.classList.toggle('opacity-50', !active);
				thumb.setAttribute('aria-current', active ? 'true' : 'false');
				if (active && syncThumb) centerThumb(thumb);
			});
			jumps.forEach((btn) => {
				const start = Number(btn.dataset.page);
				const project = projects.find((x) => x.startPage === start);
				const active = project
					? current >= project.startPage && current <= project.endPage
					: start === current;
				btn.classList.toggle('ring-1', active);
				btn.classList.toggle('ring-accent', active);
				btn.setAttribute('aria-current', active ? 'true' : 'false');
			});
			if (currentEl) currentEl.textContent = String(displayOf(current));
			if (captionEl) captionEl.textContent = captionFor(current);
			root.dataset.initial = String(current);
		}

		prevBtns.forEach((btn) => btn.addEventListener('click', () => step(-1)));
		nextBtns.forEach((btn) => btn.addEventListener('click', () => step(1)));
		thumbs.forEach((thumb) =>
			thumb.addEventListener('click', () => go(Number(thumb.dataset.page))),
		);
		jumps.forEach((btn) =>
			btn.addEventListener('click', () => {
				go(Number(btn.dataset.page));
			}),
		);

		root.addEventListener('portfolio:goto', ((e: CustomEvent<{ page: number }>) => {
			go(e.detail.page);
		}) as EventListener);

		const onKey = (e: KeyboardEvent) => {
			const tag = (e.target as HTMLElement | null)?.tagName;
			if (tag === 'INPUT' || tag === 'TEXTAREA') return;
			const rect = root.getBoundingClientRect();
			const inView = rect.top < window.innerHeight && rect.bottom > 0;
			if (!inView) return;
			if (e.key === 'ArrowLeft') {
				e.preventDefault();
				step(-1);
			}
			if (e.key === 'ArrowRight') {
				e.preventDefault();
				step(1);
			}
		};
		window.addEventListener('keydown', onKey);

		let startX = 0;
		const stage = root.querySelector<HTMLElement>('.portfolio-stage');
		stage?.addEventListener(
			'touchstart',
			(e) => {
				startX = e.changedTouches[0]?.clientX ?? 0;
			},
			{ passive: true },
		);
		stage?.addEventListener(
			'touchend',
			(e) => {
				const endX = e.changedTouches[0]?.clientX ?? 0;
				const dx = endX - startX;
				if (Math.abs(dx) < 50) return;
				if (dx < 0) step(1);
				else step(-1);
			},
			{ passive: true },
		);

		go(current, { syncThumb: false });
	}

	document.addEventListener('astro:page-load', () => {
		document.querySelectorAll<HTMLElement>('.portfolio-viewer:not([data-inited])').forEach((root) => {
			root.dataset.inited = '1';
			initPortfolioViewer(root);
		});
	});
</script>

<style>
	.portfolio-page {
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.35s ease;
	}
	.portfolio-page.is-active {
		opacity: 1;
		pointer-events: auto;
	}
</style>
