---
import { portfolioMeta, portfolioProjects } from '../../data/portfolio';

interface Props {
	/** 初始页码，从 1 开始 */
	initialPage?: number;
	class?: string;
}

const { initialPage = 1, class: className } = Astro.props;
const pages = Array.from({ length: portfolioMeta.totalPages }, (_, i) => i + 1);
---

<section
	id="portfolio"
	class:list={['portfolio-viewer band-ink scroll-mt-20', className]}
	data-total={portfolioMeta.totalPages}
	data-initial={initialPage}
>
	<div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
		<div class="reveal mb-10 flex flex-col gap-6 sm:mb-12 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="section-index mb-4">Portfolio · {portfolioMeta.totalPages} Pages</p>
				<h2 class="display-title text-3xl sm:text-5xl">作品集。</h2>
				<p class="mt-4 max-w-xl text-[15px] leading-relaxed text-[var(--color-on-ink-muted)]">
					完整作品集直接嵌在本页浏览，无需跳转外链。可用键盘 ← → 翻页。
				</p>
			</div>
			<a
				href={portfolioMeta.pdfPath}
				download="王悦-作品集2026.pdf"
				class="link-blue shrink-0 text-sm"
			>
				下载 PDF ↓
			</a>
		</div>

		<!-- 项目快捷入口 -->
		<div class="reveal mb-8 flex gap-3 overflow-x-auto pb-1 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
			{
				portfolioProjects.map((project) => (
					<button
						type="button"
						class="project-jump shrink-0 rounded-2xl bg-[var(--color-on-ink-card)] px-4 py-3 text-left transition-transform hover:-translate-y-0.5"
						data-page={project.startPage}
						aria-label={`跳转到 ${project.title}`}
					>
						<span class="block text-xs font-semibold tracking-wider text-accent">{project.number}</span>
						<span class="mt-1 block text-sm font-medium text-[var(--color-on-ink)]">{project.title}</span>
						<span class="mt-0.5 block text-xs text-[var(--color-on-ink-muted)]">{project.category}</span>
					</button>
				))
			}
		</div>

		<!-- 主画布 -->
		<div class="reveal overflow-hidden rounded-[1.5rem] bg-[var(--color-on-ink-card)] shadow-[0_30px_60px_-24px_rgba(0,0,0,0.55)] ring-1 ring-white/5">
			<div class="portfolio-stage relative aspect-[16/9] bg-black">
				{
					pages.map((n) => (
						<img
							src={portfolioMeta.pagePath(n)}
							alt={`作品集第 ${n} 页`}
							class:list={['portfolio-page absolute inset-0 h-full w-full object-contain', n === initialPage ? 'is-active' : '']}
							data-page={n}
							loading={n <= 2 ? 'eager' : 'lazy'}
							decoding="async"
						/>
					))
				}

				<button
					type="button"
					class="portfolio-prev absolute left-3 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/45 text-white backdrop-blur-md transition hover:bg-black/65 sm:left-5"
					aria-label="上一页"
				>
					<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
					</svg>
				</button>
				<button
					type="button"
					class="portfolio-next absolute right-3 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/45 text-white backdrop-blur-md transition hover:bg-black/65 sm:right-5"
					aria-label="下一页"
				>
					<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
					</svg>
				</button>
			</div>

			<div class="flex items-center justify-between gap-4 border-t border-white/5 px-5 py-4">
				<p class="text-sm text-[var(--color-on-ink-muted)]">
					<span class="portfolio-current font-semibold text-[var(--color-on-ink)]">{initialPage}</span>
					<span class="mx-1">/</span>
					<span>{portfolioMeta.totalPages}</span>
					<span class="portfolio-caption ml-3 hidden text-[var(--color-on-ink-muted)] sm:inline"></span>
				</p>
				<div class="flex gap-2">
					<button
						type="button"
						class="portfolio-prev rounded-full bg-white/5 px-4 py-1.5 text-xs font-medium text-[var(--color-on-ink)] hover:bg-white/10"
					>
						上一页
					</button>
					<button
						type="button"
						class="portfolio-next rounded-full bg-accent px-4 py-1.5 text-xs font-semibold text-white hover:bg-accent-hover"
					>
						下一页
					</button>
				</div>
			</div>
		</div>

		<!-- 缩略图条 -->
		<div
			class="reveal mt-5 flex gap-2 overflow-x-auto pb-2 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
			role="tablist"
			aria-label="作品集缩略图"
		>
			{
				pages.map((n) => (
					<button
						type="button"
						class:list={[
							'portfolio-thumb shrink-0 overflow-hidden rounded-lg ring-2 transition',
							n === initialPage ? 'ring-accent' : 'ring-transparent opacity-55 hover:opacity-100',
						]}
						data-page={n}
						aria-label={`第 ${n} 页`}
						aria-current={n === initialPage ? 'true' : undefined}
					>
						<img
							src={portfolioMeta.pagePath(n)}
							alt=""
							class="h-14 w-[99px] object-cover sm:h-16 sm:w-[114px]"
							loading="lazy"
							decoding="async"
						/>
					</button>
				))
			}
		</div>
	</div>
</section>

<script>
	import { portfolioProjects } from '../../data/portfolio';

	function initPortfolioViewer(root: HTMLElement) {
		const total = Number(root.dataset.total || 31);
		let current = Number(root.dataset.initial || 1);

		const pages = root.querySelectorAll<HTMLImageElement>('.portfolio-page');
		const thumbs = root.querySelectorAll<HTMLButtonElement>('.portfolio-thumb');
		const currentEl = root.querySelector<HTMLElement>('.portfolio-current');
		const captionEl = root.querySelector<HTMLElement>('.portfolio-caption');
		const prevBtns = root.querySelectorAll('.portfolio-prev');
		const nextBtns = root.querySelectorAll('.portfolio-next');
		const jumps = root.querySelectorAll<HTMLButtonElement>('.project-jump');

		function captionFor(page: number) {
			const project = portfolioProjects.find((p) => page >= p.startPage && page <= p.endPage);
			return project ? `${project.number} · ${project.title}` : '作品集';
		}

		function go(page: number) {
			current = Math.max(1, Math.min(total, page));
			pages.forEach((img) => {
				img.classList.toggle('is-active', Number(img.dataset.page) === current);
			});
			thumbs.forEach((thumb) => {
				const active = Number(thumb.dataset.page) === current;
				thumb.classList.toggle('ring-accent', active);
				thumb.classList.toggle('ring-transparent', !active);
				thumb.classList.toggle('opacity-55', !active);
				thumb.setAttribute('aria-current', active ? 'true' : 'false');
				if (active) {
					thumb.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
				}
			});
			if (currentEl) currentEl.textContent = String(current);
			if (captionEl) captionEl.textContent = captionFor(current);
			root.dataset.initial = String(current);
		}

		prevBtns.forEach((btn) => btn.addEventListener('click', () => go(current - 1)));
		nextBtns.forEach((btn) => btn.addEventListener('click', () => go(current + 1)));
		thumbs.forEach((thumb) =>
			thumb.addEventListener('click', () => go(Number(thumb.dataset.page))),
		);
		jumps.forEach((btn) =>
			btn.addEventListener('click', () => {
				go(Number(btn.dataset.page));
				root.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}),
		);

		root.addEventListener('portfolio:goto', ((e: CustomEvent<{ page: number }>) => {
			go(e.detail.page);
		}) as EventListener);

		const onKey = (e: KeyboardEvent) => {
			const tag = (e.target as HTMLElement | null)?.tagName;
			if (tag === 'INPUT' || tag === 'TEXTAREA') return;
			const rect = root.getBoundingClientRect();
			const inView = rect.top < window.innerHeight && rect.bottom > 0;
			if (!inView) return;
			if (e.key === 'ArrowLeft') {
				e.preventDefault();
				go(current - 1);
			}
			if (e.key === 'ArrowRight') {
				e.preventDefault();
				go(current + 1);
			}
		};
		window.addEventListener('keydown', onKey);

		// 轻触滑动
		let startX = 0;
		const stage = root.querySelector<HTMLElement>('.portfolio-stage');
		stage?.addEventListener(
			'touchstart',
			(e) => {
				startX = e.changedTouches[0]?.clientX ?? 0;
			},
			{ passive: true },
		);
		stage?.addEventListener(
			'touchend',
			(e) => {
				const endX = e.changedTouches[0]?.clientX ?? 0;
				const dx = endX - startX;
				if (Math.abs(dx) < 50) return;
				if (dx < 0) go(current + 1);
				else go(current - 1);
			},
			{ passive: true },
		);

		go(current);
	}

	document.querySelectorAll<HTMLElement>('.portfolio-viewer').forEach(initPortfolioViewer);
</script>

<style>
	.portfolio-page {
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.35s ease;
	}
	.portfolio-page.is-active {
		opacity: 1;
		pointer-events: auto;
	}
</style>
