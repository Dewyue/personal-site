---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortfolioViewer from '../portfolio/PortfolioViewer.astro';
import { getUi, localizePath, type Locale } from '../../i18n';
import { loadLocalizedContent } from '../../i18n/loadContent';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getUi(locale);
const { site, projects: portfolioProjects } = await loadLocalizedContent(locale);
const homeBase = localizePath(locale, '/');
---

<BaseLayout title={t.projects.title} description={t.projects.description} locale={locale}>
	<section class="py-16 sm:py-24">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<p class="section-index reveal mb-4">{t.projects.works}</p>
			<h1 class="display-title reveal text-4xl sm:text-5xl">{t.projects.headline}</h1>
			<p class="reveal mt-4 max-w-2xl text-base leading-relaxed text-muted">
				{t.projects.intro}
			</p>

			<div class="mt-10">
				<p class="section-index reveal mb-3">{t.home.labsLabel}</p>
				<a
					href={site.social.folio}
					target="_blank"
					rel="noopener noreferrer"
					class="tile tile-hover reveal flex items-end justify-between gap-4 p-6 sm:p-7"
				>
					<div>
						<h2 class="display-title text-2xl sm:text-3xl">{t.projects.labsTitle}</h2>
						<p class="mt-2 max-w-md text-sm leading-relaxed text-muted">{t.projects.labsBody}</p>
					</div>
					<span class="link-blue shrink-0 text-sm font-semibold">{t.projects.labsCta}</span>
				</a>
			</div>

			<div class="mt-12">
				<p class="section-index reveal mb-3">{t.home.deckLabel}</p>
				<h2 class="display-title reveal mb-5 text-2xl sm:text-3xl">{t.projects.deckTitle}</h2>
			<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
				{
					portfolioProjects.map((project) => (
						<a
							href={`${homeBase}?page=${project.startPage}#portfolio`}
							class="tile tile-hover group reveal block overflow-hidden"
							data-jump-page={project.startPage}
						>
							<img
								src={project.cover}
								alt={project.title}
								class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
								loading="lazy"
							/>
							<div class="p-4">
								<p class="text-[11px] font-semibold tracking-wider text-accent">
									{project.number} · {project.category}
								</p>
								<h2 class="mt-1.5 text-sm font-semibold tracking-tight leading-snug">{project.title}</h2>
							</div>
						</a>
					))
				}
			</div>
			</div>
		</div>
	</section>

	<PortfolioViewer locale={locale} variant="embedded" />
</BaseLayout>

<script>
	function bindProjectJumps() {
		document.querySelectorAll<HTMLAnchorElement>('[data-jump-page]').forEach((link) => {
			if (link.dataset.bound === '1') return;
			link.dataset.bound = '1';
			link.addEventListener('click', (e) => {
				const page = Number(link.dataset.jumpPage);
				if (!page) return;
				const viewer = document.querySelector<HTMLElement>('.portfolio-viewer');
				if (!viewer) return;
				e.preventDefault();
				viewer.scrollIntoView({ behavior: 'smooth', block: 'start' });
				viewer.dispatchEvent(new CustomEvent('portfolio:goto', { detail: { page } }));
			});
		});
	}

	document.addEventListener('astro:page-load', bindProjectJumps);
</script>
