---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getUi, localizePath, type Locale } from '../../i18n';
import { loadLocalizedContent } from '../../i18n/loadContent';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getUi(locale);
const { site, skills, timeline, skillCategories, aboutStory, projects: portfolioProjects } = await loadLocalizedContent(locale);

const marqueeSkills = [...skills, ...skills];
const pathHref = localizePath(locale, '/about');
const timelineHref = `${pathHref}#timeline`;
const projectsHref = localizePath(locale, '/projects');
const contactHref = localizePath(locale, '/contact');

/** 首页只展示工作经历，完整路径去经历页 */
const workItems = timeline.filter(
	(item) =>
		item.category === t.about.catWork ||
		item.category === '工作经历' ||
		item.category === 'Work',
);
const highlightItems = (workItems.length > 0 ? workItems : timeline).slice(0, 2);
const education = timeline.find(
	(item) =>
		item.category === t.about.catEducation ||
		item.category === '教育经历' ||
		item.category === 'Education',
);
const educationLine = education
	? locale === 'zh'
		? `${education.company}${education.title} · ${education.year}`
		: `${education.company} · ${education.title} · ${education.year}`
	: '';
---

<BaseLayout title={site.name} description={site.description} locale={locale} site={site}>
	<section class="py-16 sm:py-24">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<div class="grid items-center gap-12 sm:grid-cols-2">
				<div>
					<p class="section-index reveal mb-5">{site.title}</p>
					<h1 class="display-title reveal text-5xl sm:text-6xl lg:text-7xl">
						{t.home.hello}<br />{t.home.iam}{locale === 'en' ? ' ' : ''}{site.name}{locale === 'zh' ? '。' : '.'}
					</h1>
					{
						educationLine && (
							<p class="reveal mt-5">
								<span class="inline-flex items-center rounded-full bg-accent-soft px-4 py-1.5 text-sm font-semibold text-accent sm:text-[15px]">
									{educationLine}
								</span>
							</p>
						)
					}
					<p class="reveal mt-6 max-w-xl text-lg leading-relaxed text-muted">
						{site.tagline}
					</p>
					<div class="reveal mt-9 flex flex-wrap items-center gap-4">
						<a
							href={pathHref}
							class="rounded-full bg-accent px-7 py-3 text-sm font-semibold text-white hover:bg-accent-hover"
						>
							{t.home.experienceCta.replace(/\s*→\s*$/, '')}
						</a>
						<a href={contactHref} class="link-blue text-sm">{t.contactCta} →</a>
					</div>
				</div>

				<div class="reveal order-first flex justify-center sm:order-none sm:justify-end sm:pr-4 lg:pr-8">
					<div class="avatar-circle sm:translate-y-3 lg:translate-y-4">
						<img
							src={site.avatar}
							alt={`${site.name}${t.home.avatarAlt}`}
							width="640"
							height="640"
							class="!object-[center_46%]"
						/>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section id="experience" class="band-ink scroll-mt-20 py-20 sm:py-28">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<div class="reveal mb-8 flex flex-col gap-4 sm:mb-10 sm:flex-row sm:items-end sm:justify-between">
				<div>
					<p class="section-index mb-3">{t.home.experienceIndex}</p>
					<h2 class="display-title text-3xl sm:text-5xl">{t.about.timeline}</h2>
				</div>
				<a href={timelineHref} class="link-blue shrink-0 text-sm font-semibold">
					{t.home.fullPathCta}
				</a>
			</div>
			<div class="reveal mb-10 max-w-3xl space-y-3 sm:mb-12">
				{
					aboutStory.paragraphs.map((p, i) => (
						<p
							class:list={[
								'leading-relaxed',
								i === 0
									? 'text-[15px] leading-relaxed text-[var(--color-on-ink)]/70 sm:text-base'
									: 'text-[13px] leading-relaxed text-[var(--color-on-ink-muted)] sm:text-sm',
							]}
						>
							{p}
						</p>
					))
				}
			</div>

			<div class="flex flex-col gap-4">
				{
					highlightItems.map((item) => (
						<article class="card-on-ink reveal rounded-[1.75rem] p-7 sm:p-8">
							<div class="flex flex-col gap-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
								<div>
									<p class="text-xs font-semibold tracking-[0.14em] text-accent uppercase">
										{item.category}
									</p>
									<h3 class="mt-2 text-xl font-semibold tracking-tight">{item.title}</h3>
									<p class="mt-1 text-sm text-[var(--color-on-ink-muted)]">{item.company}</p>
								</div>
								<p class="shrink-0 text-sm font-medium text-[var(--color-on-ink-muted)]">{item.year}</p>
							</div>
							<p class="mt-4 text-sm leading-relaxed text-[var(--color-on-ink-muted)]">{item.description}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section id="capabilities" class="scroll-mt-20 py-20 sm:py-28">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<div class="reveal mb-12 text-center sm:mb-16">
				<p class="section-index mb-4">Capabilities</p>
				<h2 class="display-title text-3xl sm:text-5xl">{t.home.capabilities}</h2>
			</div>
			<div class="grid gap-5 sm:grid-cols-3">
				{
					skillCategories.map((cat) => (
						<div class="tile tile-hover reveal p-8">
							<h3 class="text-xl font-semibold tracking-tight">{cat.title}</h3>
							<ul class="mt-5 space-y-2.5">
								{cat.items.map((item) => (
									<li class="flex items-center gap-2.5 text-sm text-muted">
										<span class="h-1 w-1 rounded-full bg-accent" />
										{item}
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<div class="band-ink overflow-hidden py-5" aria-label={t.home.skillsAria}>
		<div class="marquee-track items-center gap-10">
			{
				marqueeSkills.map((skill) => (
					<span class="flex shrink-0 items-center gap-10">
						<span class="text-sm font-medium uppercase tracking-[0.15em]">{skill.name}</span>
						<span class="h-1 w-1 rounded-full bg-accent" />
					</span>
				))
			}
		</div>
	</div>

	<section id="works" class="scroll-mt-20 py-12 sm:py-16">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<a
				href={projectsHref}
				class="tile reveal group block overflow-hidden p-3 transition-shadow duration-300 hover:shadow-[0_20px_40px_-16px_rgba(0,0,0,0.12)] sm:p-4"
			>
				<div class="flex items-end justify-between gap-4 px-4 pt-4 sm:px-5 sm:pt-5">
					<div>
						<p class="section-index mb-2">Portfolio</p>
						<h2 class="display-title text-2xl sm:text-3xl">{t.home.portfolioTeaserTitle}</h2>
					</div>
					<span class="link-blue mb-1 shrink-0 text-sm font-semibold">{t.home.browsePortfolio} →</span>
				</div>
				<div class="mt-5 grid grid-cols-2 gap-2 sm:mt-6 sm:grid-cols-4 sm:gap-2.5">
					{
						portfolioProjects.slice(0, 4).map((project) => (
							<div class="flex aspect-[4/3] items-center justify-center overflow-hidden rounded-[1.25rem] bg-surface">
								<img
									src={project.cover}
									alt={project.title}
									class="max-h-full max-w-full object-contain"
									loading="lazy"
								/>
							</div>
						))
					}
				</div>
			</a>
		</div>
	</section>
</BaseLayout>
