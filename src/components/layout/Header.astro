---
import { site as fallbackSite } from '../../data/site';
import { enSite } from '../../i18n/content/en';
import {
	getAlternatePath,
	getUi,
	localizePath,
	navItems,
	resolveLocale,
	type Locale,
} from '../../i18n';

interface Props {
	site?: typeof fallbackSite | typeof enSite | Record<string, any>;
	locale?: Locale;
}

const locale = resolveLocale(Astro.props.locale ?? Astro.currentLocale);
const t = getUi(locale);
const site = (Astro.props.site || (locale === 'en' ? enSite : fallbackSite)) as typeof fallbackSite;
const items = navItems(locale);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const brandName = locale === 'en' ? site.englishName || site.name : site.name;
const contactHref = localizePath(locale, '/contact');
const homeHref = localizePath(locale, '/');
const altZh = getAlternatePath(Astro.url.pathname, 'zh');
const altEn = getAlternatePath(Astro.url.pathname, 'en');
---

<header class="sticky top-0 z-50 bg-[var(--color-surface)]/80 backdrop-blur-xl backdrop-saturate-150">
	<div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:px-6">
		<a href={homeHref} class="text-[17px] font-semibold tracking-tight hover:opacity-70">
			{brandName}
		</a>

		<nav class="hidden items-center gap-8 md:flex" aria-label={t.mainNav}>
			{
				items.map((item) => {
					const itemPath = item.href.replace(/\/$/, '') || '/';
					const isActive =
						item.external
							? false
							: itemPath === homeHref || itemPath === '/'
								? currentPath === itemPath
								: currentPath === itemPath || currentPath.startsWith(`${itemPath}/`);
					return (
						<a
							href={item.href}
							target={item.external ? '_blank' : undefined}
							rel={item.external ? 'noopener noreferrer' : undefined}
							class:list={[
								'text-sm transition-opacity',
								isActive
									? 'font-semibold text-foreground'
									: 'text-muted hover:text-foreground',
							]}
							aria-current={isActive ? 'page' : undefined}
						>
							{item.label}
						</a>
					);
				})
			}
		</nav>

		<div class="flex items-center gap-1.5">
			<a
				href={contactHref}
				class="mr-1 hidden rounded-full bg-accent px-4 py-1.5 text-xs font-semibold text-white hover:bg-accent-hover sm:inline-block"
			>
				{t.contactCta}
			</a>

			<div
				class="mr-0.5 flex items-center rounded-full bg-surface-muted p-0.5 text-[11px] font-semibold tracking-wide"
				role="group"
				aria-label="Language"
			>
				<a
					href={altZh}
					data-lang-switch
					class:list={[
						'rounded-full px-2 py-1 transition-colors',
						locale === 'zh'
							? 'bg-[var(--color-surface-raised)] text-foreground shadow-sm'
							: 'text-muted hover:text-foreground',
					]}
					aria-label={t.lang.switchToZh}
					aria-current={locale === 'zh' ? 'true' : undefined}
					hreflang="zh-CN"
				>
					{t.lang.zh}
				</a>
				<a
					href={altEn}
					data-lang-switch
					class:list={[
						'rounded-full px-2 py-1 transition-colors',
						locale === 'en'
							? 'bg-[var(--color-surface-raised)] text-foreground shadow-sm'
							: 'text-muted hover:text-foreground',
					]}
					aria-label={t.lang.switchToEn}
					aria-current={locale === 'en' ? 'true' : undefined}
					hreflang="en"
				>
					{t.lang.en}
				</a>
			</div>

			<button
				id="theme-toggle"
				type="button"
				class="rounded-full p-2 text-muted hover:bg-surface-muted hover:text-foreground"
				aria-label={t.themeToggle}
			>
				<svg
					id="icon-sun"
					class="hidden h-4 w-4 dark:block"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
					stroke-width="2"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
					></path>
				</svg>
				<svg
					id="icon-moon"
					class="h-4 w-4 dark:hidden"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
					stroke-width="2"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
					></path>
				</svg>
			</button>

			<details class="relative md:hidden">
				<summary
					class="list-none rounded-full p-2 text-muted hover:bg-surface-muted hover:text-foreground [&::-webkit-details-marker]:hidden"
					aria-label={t.openMenu}
				>
					<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
					</svg>
				</summary>
				<nav
					class="absolute right-0 mt-3 w-44 rounded-2xl bg-[var(--color-surface-raised)] p-2 shadow-2xl ring-1 ring-black/5"
					aria-label={t.mobileNav}
				>
					{
						items.map((item) => (
							<a
								href={item.href}
								target={item.external ? '_blank' : undefined}
								rel={item.external ? 'noopener noreferrer' : undefined}
								class="block rounded-xl px-3.5 py-2.5 text-sm font-medium text-muted hover:bg-surface-muted hover:text-foreground"
							>
								{item.label}
							</a>
						))
					}
					<div class="my-1 border-t border-black/5" />
					<a
						href={altZh}
						data-lang-switch
						class="block rounded-xl px-3.5 py-2.5 text-sm font-medium text-muted hover:bg-surface-muted hover:text-foreground"
					>
						中文
					</a>
					<a
						href={altEn}
						data-lang-switch
						class="block rounded-xl px-3.5 py-2.5 text-sm font-medium text-muted hover:bg-surface-muted hover:text-foreground"
					>
						English
					</a>
				</nav>
			</details>
		</div>
	</div>
</header>

<script>
	const SCROLL_KEY = 'lang-switch-scroll';

	document.addEventListener(
		'click',
		(e) => {
			const link = (e.target as HTMLElement | null)?.closest?.('[data-lang-switch]');
			if (!(link instanceof HTMLAnchorElement)) return;
			if (link.getAttribute('aria-current') === 'true') {
				e.preventDefault();
				return;
			}
			try {
				sessionStorage.setItem(SCROLL_KEY, String(window.scrollY || window.pageYOffset || 0));
			} catch {
				/* ignore */
			}
		},
		true,
	);

	document.addEventListener('astro:before-preparation', ((e: Event) => {
		const ev = e as Event & { sourceElement?: Element | null };
		const link = ev.sourceElement?.closest?.('[data-lang-switch]');
		if (!link) return;
		try {
			sessionStorage.setItem(SCROLL_KEY, String(window.scrollY || window.pageYOffset || 0));
		} catch {
			/* ignore */
		}
	}) as EventListener);

	document.addEventListener('click', (e) => {
		const toggle = (e.target as HTMLElement | null)?.closest?.('#theme-toggle');
		if (!toggle) return;
		const isDark = document.documentElement.classList.toggle('dark');
		localStorage.setItem('theme', isDark ? 'dark' : 'light');
	});
</script>
