---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { listMessages } from '../../lib/cms/messages';
import { site } from '../../data/site';

const messages = await listMessages();
const unread = messages.filter((m) => m.status === 'unread').length;

function intentLabel(intent: string) {
	return intent === 'resume' ? '索取简历' : '一般留言';
}

function statusLabel(status: string) {
	if (status === 'unread') return '未读';
	if (status === 'replied') return '已回复';
	return '已读';
}
---

<AdminLayout
	title="留言箱"
	description={`访客站内留言。未读 ${unread} 条。点「邮件回复」会打开你的邮箱客户端。`}
>
	{
		messages.length === 0 ? (
			<p class="text-sm text-muted">还没有留言。访客可在联系页提交。</p>
		) : (
			<ul class="space-y-4" id="message-list">
				{messages.map((m) => {
					const mailSubject =
						m.intent === 'resume'
							? encodeURIComponent(`Re: 简历索取 — ${m.name}`)
							: encodeURIComponent(`Re: ${m.name} 的留言`);
					const mailBody = encodeURIComponent(
						`你好 ${m.name}，\n\n（在此写回复）\n\n---\n对方留言：\n${m.body}\n`,
					);
					const mailto = `mailto:${m.email}?subject=${mailSubject}&body=${mailBody}`;
					return (
						<li
							class="rounded-2xl border border-border bg-surface p-5"
							data-id={m.id}
							data-status={m.status}
						>
							<div class="flex flex-wrap items-start justify-between gap-3">
								<div>
									<p class="text-sm font-semibold">
										{m.name}
										<span class="ml-2 font-normal text-muted">{m.email}</span>
									</p>
									<p class="mt-1 text-xs text-muted">
										{new Date(m.createdAt).toLocaleString('zh-CN')} · {intentLabel(m.intent)} ·{' '}
										<span class="status-label">{statusLabel(m.status)}</span>
									</p>
								</div>
								<div class="flex flex-wrap gap-2">
									<a
										href={mailto}
										class="rounded-full bg-accent px-3.5 py-1.5 text-xs font-semibold text-white hover:bg-accent-hover"
										data-mark-replied
									>
										邮件回复
									</a>
									<button
										type="button"
										class="rounded-full border border-border px-3.5 py-1.5 text-xs font-medium hover:border-accent"
										data-mark-read
									>
										标为已读
									</button>
								</div>
							</div>
							<p class="mt-4 whitespace-pre-wrap text-sm leading-relaxed">{m.body}</p>
							{m.adminNote && (
								<p class="mt-3 rounded-xl bg-surface-muted px-3 py-2 text-xs text-muted">备注：{m.adminNote}</p>
							)}
						</li>
					);
				})}
			</ul>
		)
	}

	<p class="mt-8 text-xs text-muted">
		你的公开邮箱是 {site.email}。访客也可直接点联系页的「电子邮件」给你写信（mailto）。
	</p>
</AdminLayout>

<script>
	async function patch(id: string, status: string) {
		await fetch('/api/admin/messages', {
			method: 'PATCH',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ id, status }),
		});
	}

	document.querySelectorAll<HTMLElement>('[data-id]').forEach((card) => {
		const id = card.dataset.id!;
		card.querySelector('[data-mark-read]')?.addEventListener('click', async () => {
			await patch(id, 'read');
			card.dataset.status = 'read';
			const label = card.querySelector('.status-label');
			if (label) label.textContent = '已读';
		});
		card.querySelector('[data-mark-replied]')?.addEventListener('click', async () => {
			await patch(id, 'replied');
			card.dataset.status = 'replied';
			const label = card.querySelector('.status-label');
			if (label) label.textContent = '已回复';
		});
	});
</script>
