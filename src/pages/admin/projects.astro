---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { listProjects } from '../../lib/cms/store';

const projects = await listProjects();
---

<AdminLayout title="作品管理" description="作品集项目卡片信息（封面页码与摘要）。">
	<div class="mb-4 flex justify-end">
		<button id="add-project" type="button" class="rounded-full bg-accent px-5 py-2 text-sm font-semibold text-white"
			>+ 添加作品</button
		>
	</div>
	<div id="project-list" class="space-y-4" data-projects={JSON.stringify(projects)}></div>
	<div class="mt-6 flex items-center gap-3">
		<button id="save-projects" type="button" class="rounded-full bg-accent px-6 py-2.5 text-sm font-semibold text-white"
			>保存全部</button
		>
		<p id="project-status" class="text-sm text-muted"></p>
	</div>
</AdminLayout>

<style>
	.field {
		width: 100%;
		border-radius: 0.75rem;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		padding: 0.5rem 0.75rem;
		font-size: 0.875rem;
	}
</style>

<script>
	type Project = {
		id: string;
		number: string;
		title: string;
		category: string;
		summary: string;
		cover: string;
		startPage: number;
		endPage: number;
		visible: boolean;
		sort: number;
	};

	const listEl = document.getElementById('project-list')!;
	let projects: Project[] = JSON.parse(listEl.dataset.projects || '[]');

	const esc = (s: string) => s.replaceAll('&', '&amp;').replaceAll('"', '&quot;');

	function render() {
		listEl.innerHTML = projects
			.map(
				(p, i) => `
			<article class="rounded-2xl border border-border bg-surface p-5" data-i="${i}">
				<div class="mb-3 flex justify-between">
					<p class="text-sm font-semibold">${esc(p.number)} · ${esc(p.title) || '未命名'}</p>
					<div class="flex gap-3">
						<label class="text-xs text-muted"><input type="checkbox" data-k="visible" ${p.visible ? 'checked' : ''}/> 显示</label>
						<button type="button" data-del class="text-xs text-red-500">删除</button>
					</div>
				</div>
				<div class="grid gap-3 sm:grid-cols-2">
					<label class="text-xs text-muted">ID<input class="field mt-1" data-k="id" value="${esc(p.id)}" /></label>
					<label class="text-xs text-muted">序号<input class="field mt-1" data-k="number" value="${esc(p.number)}" /></label>
					<label class="text-xs text-muted">标题<input class="field mt-1" data-k="title" value="${esc(p.title)}" /></label>
					<label class="text-xs text-muted">分类<input class="field mt-1" data-k="category" value="${esc(p.category)}" /></label>
					<label class="text-xs text-muted sm:col-span-2">摘要<textarea class="field mt-1" data-k="summary" rows="2">${esc(p.summary)}</textarea></label>
					<label class="text-xs text-muted">封面<input class="field mt-1" data-k="cover" value="${esc(p.cover)}" /></label>
					<label class="text-xs text-muted">排序<input class="field mt-1" data-k="sort" type="number" value="${p.sort}" /></label>
					<label class="text-xs text-muted">起始页<input class="field mt-1" data-k="startPage" type="number" value="${p.startPage}" /></label>
					<label class="text-xs text-muted">结束页<input class="field mt-1" data-k="endPage" type="number" value="${p.endPage}" /></label>
				</div>
			</article>`,
			)
			.join('');
	}

	listEl.addEventListener('input', (e) => {
		const t = e.target as HTMLInputElement | HTMLTextAreaElement;
		const card = t.closest('article') as HTMLElement;
		const i = Number(card.dataset.i);
		const k = t.dataset.k as keyof Project;
		if (['sort', 'startPage', 'endPage'].includes(k)) (projects[i] as any)[k] = Number(t.value);
		else if (k === 'visible') projects[i].visible = (t as HTMLInputElement).checked;
		else if (k) (projects[i] as any)[k] = t.value;
	});

	listEl.addEventListener('change', (e) => {
		const t = e.target as HTMLInputElement;
		if (t.dataset.k !== 'visible') return;
		const i = Number((t.closest('article') as HTMLElement).dataset.i);
		projects[i].visible = t.checked;
	});

	listEl.addEventListener('click', (e) => {
		const t = e.target as HTMLElement;
		if (!t.matches('[data-del]')) return;
		projects.splice(Number((t.closest('article') as HTMLElement).dataset.i), 1);
		render();
	});

	document.getElementById('add-project')!.addEventListener('click', () => {
		projects.push({
			id: `project-${projects.length + 1}`,
			number: String(projects.length + 1).padStart(2, '0'),
			title: '',
			category: '',
			summary: '',
			cover: '/portfolio/page-01.jpg',
			startPage: 1,
			endPage: 1,
			visible: true,
			sort: projects.length + 1,
		});
		render();
	});

	document.getElementById('save-projects')!.addEventListener('click', async () => {
		const status = document.getElementById('project-status')!;
		status.textContent = '保存中…';
		const res = await fetch('/api/admin/data?resource=projects', {
			method: 'PUT',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify(projects),
		});
		status.textContent = res.ok ? '已保存' : '保存失败';
	});

	render();
</script>
