---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { listMovies } from '../../lib/cms/store';

const movies = await listMovies();
---

<AdminLayout title="电影管理" description="人生电影排名：增删改查，控制前台展示。">
	<div class="mb-4 flex items-center justify-between gap-3">
		<p class="text-sm text-muted">共 {movies.length} 部</p>
		<button
			id="add-movie"
			type="button"
			class="rounded-full bg-accent px-5 py-2 text-sm font-semibold text-white hover:bg-accent-hover"
		>
			+ 添加电影
		</button>
	</div>

	<div id="movie-list" class="space-y-4" data-movies={JSON.stringify(movies)}></div>

	<div class="mt-6 flex items-center gap-3">
		<button
			id="save-movies"
			type="button"
			class="rounded-full bg-accent px-6 py-2.5 text-sm font-semibold text-white hover:bg-accent-hover"
		>
			保存全部
		</button>
		<p id="movie-status" class="text-sm text-muted"></p>
	</div>
</AdminLayout>

<style>
	.field {
		width: 100%;
		border-radius: 0.75rem;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		padding: 0.5rem 0.75rem;
		font-size: 0.875rem;
		outline: none;
	}
	.field:focus {
		border-color: var(--color-accent);
	}
</style>

<script>
	type Movie = {
		id: string;
		rank: number;
		title: string;
		titleEn: string;
		year: number;
		poster: string;
		imdb: string;
		visible: boolean;
	};

	const listEl = document.getElementById('movie-list')!;
	let movies: Movie[] = JSON.parse(listEl.dataset.movies || '[]');

	function uid() {
		return Math.random().toString(36).slice(2, 12);
	}

	function render() {
		listEl.innerHTML = movies
			.map(
				(m, i) => `
			<article class="rounded-2xl border border-border bg-surface p-5" data-i="${i}">
				<div class="mb-3 flex items-center justify-between gap-3">
					<p class="text-sm font-semibold">#${m.rank} ${m.title || '未命名'}</p>
					<div class="flex gap-2">
						<label class="flex items-center gap-1.5 text-xs text-muted">
							<input type="checkbox" data-k="visible" ${m.visible ? 'checked' : ''} /> 显示
						</label>
						<button type="button" data-del class="text-xs text-red-500 hover:underline">删除</button>
					</div>
				</div>
				<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
					<label class="text-xs text-muted">排名<input class="field mt-1" data-k="rank" type="number" value="${m.rank}" /></label>
					<label class="text-xs text-muted">中文名<input class="field mt-1" data-k="title" value="${escapeAttr(m.title)}" /></label>
					<label class="text-xs text-muted">英文名<input class="field mt-1" data-k="titleEn" value="${escapeAttr(m.titleEn)}" /></label>
					<label class="text-xs text-muted">年份<input class="field mt-1" data-k="year" type="number" value="${m.year}" /></label>
					<label class="text-xs text-muted">海报路径<input class="field mt-1" data-k="poster" value="${escapeAttr(m.poster)}" /></label>
					<label class="text-xs text-muted">IMDb 链接<input class="field mt-1" data-k="imdb" value="${escapeAttr(m.imdb)}" /></label>
				</div>
			</article>
		`,
			)
			.join('');
	}

	function escapeAttr(s: string) {
		return s.replaceAll('&', '&amp;').replaceAll('"', '&quot;').replaceAll('<', '&lt;');
	}

	listEl.addEventListener('input', (e) => {
		const t = e.target as HTMLInputElement;
		const card = t.closest('article') as HTMLElement | null;
		if (!card) return;
		const i = Number(card.dataset.i);
		const k = t.dataset.k as keyof Movie;
		if (k === 'rank' || k === 'year') movies[i][k] = Number(t.value) as never;
		else if (k === 'visible') movies[i].visible = t.checked;
		else if (k) (movies[i] as any)[k] = t.value;
	});

	listEl.addEventListener('change', (e) => {
		const t = e.target as HTMLInputElement;
		if (t.dataset.k === 'visible') {
			const card = t.closest('article') as HTMLElement;
			movies[Number(card.dataset.i)].visible = t.checked;
		}
	});

	listEl.addEventListener('click', (e) => {
		const t = e.target as HTMLElement;
		if (t.matches('[data-del]')) {
			const card = t.closest('article') as HTMLElement;
			movies.splice(Number(card.dataset.i), 1);
			render();
		}
	});

	document.getElementById('add-movie')!.addEventListener('click', () => {
		movies.push({
			id: uid(),
			rank: movies.length + 1,
			title: '',
			titleEn: '',
			year: new Date().getFullYear(),
			poster: '',
			imdb: '',
			visible: true,
		});
		render();
	});

	document.getElementById('save-movies')!.addEventListener('click', async () => {
		const status = document.getElementById('movie-status')!;
		status.textContent = '保存中…';
		const res = await fetch('/api/admin/data?resource=movies', {
			method: 'PUT',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify(movies),
		});
		status.textContent = res.ok ? '已保存' : '保存失败';
	});

	render();
</script>
