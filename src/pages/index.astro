---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioViewer from '../components/portfolio/PortfolioViewer.astro';
import { site, skills, skillCategories } from '../data/site';
import { portfolioProjects } from '../data/portfolio';
import { getCollection } from 'astro:content';

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const marqueeSkills = [...skills, ...skills];

function formatDate(date: Date) {
	return date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout title={site.name} description={site.description}>
	<!-- Hero -->
	<section class="py-16 sm:py-24">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<div class="grid items-center gap-12 sm:grid-cols-2">
				<div>
					<p class="section-index reveal mb-5">{site.title}</p>
					<h1 class="display-title reveal text-5xl sm:text-6xl lg:text-7xl">
						你好，<br />我是{site.name}。
					</h1>
					<p class="reveal mt-6 max-w-md text-lg leading-relaxed text-muted">
						{site.tagline}
					</p>
					<div class="reveal mt-9 flex flex-wrap items-center gap-4">
						<a
							href="#portfolio"
							class="rounded-full bg-accent px-7 py-3 text-sm font-semibold text-white hover:bg-accent-hover"
						>
							浏览作品集
						</a>
						<a href="/about" class="link-blue text-sm">进一步了解 →</a>
					</div>
				</div>

				<div class="reveal order-first sm:order-none">
					<div class="avatar-circle mx-auto">
						<img src={site.avatar} alt={`${site.name}的头像`} width="640" height="640" />
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- 作品概览：跳转到站内翻页 -->
	<section class="pb-4 sm:pb-8">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<div class="reveal mb-10 sm:mb-12">
				<p class="section-index mb-4">Selected Works</p>
				<h2 class="display-title text-3xl sm:text-5xl">精选作品。</h2>
			</div>
			<div class="grid gap-5 sm:grid-cols-2">
				{
					portfolioProjects.map((project) => (
						<a
							href={`/?page=${project.startPage}#portfolio`}
							class="tile tile-hover group reveal block overflow-hidden"
							data-jump-page={project.startPage}
						>
							<div class="overflow-hidden">
								<img
									src={project.cover}
									alt={project.title}
									class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
									loading="lazy"
								/>
							</div>
							<div class="p-7">
								<p class="text-xs font-semibold tracking-wider text-accent">
									{project.number} · {project.category}
								</p>
								<h3 class="mt-2 text-xl font-semibold tracking-tight">{project.title}</h3>
								<p class="mt-2 line-clamp-2 text-sm leading-relaxed text-muted">{project.summary}</p>
								<span class="link-blue mt-4 inline-block text-sm">在作品集中查看 →</span>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<!-- 站内内嵌完整作品集 -->
	<PortfolioViewer />

	<!-- 技能 -->
	<section class="py-20 sm:py-28">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<div class="reveal mb-12 text-center sm:mb-16">
				<p class="section-index mb-4">Capabilities</p>
				<h2 class="display-title text-3xl sm:text-5xl">能做什么。</h2>
			</div>
			<div class="grid gap-5 sm:grid-cols-3">
				{
					skillCategories.map((cat) => (
						<div class="tile tile-hover reveal p-8">
							<h3 class="text-xl font-semibold tracking-tight">{cat.title}</h3>
							<ul class="mt-5 space-y-2.5">
								{cat.items.map((item) => (
									<li class="flex items-center gap-2.5 text-sm text-muted">
										<span class="h-1 w-1 rounded-full bg-accent" />
										{item}
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<div class="band-ink overflow-hidden py-5" aria-label="技能一览">
		<div class="marquee-track items-center gap-10">
			{
				marqueeSkills.map((skill) => (
					<span class="flex shrink-0 items-center gap-10">
						<span class="text-sm font-medium uppercase tracking-[0.15em]">{skill.name}</span>
						<span class="h-1 w-1 rounded-full bg-accent" />
					</span>
				))
			}
		</div>
	</div>

	<!-- 博客示例保留 -->
	<section class="py-20 sm:py-28">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<div class="reveal mb-12 sm:mb-16">
				<p class="section-index mb-4">Journal</p>
				<h2 class="display-title text-3xl sm:text-5xl">最新文章。</h2>
			</div>
			<div class="grid gap-5 sm:grid-cols-3">
				{
					latestPosts.map((post) => (
						<a href={`/blog/${post.id}`} class="tile group tile-hover flex flex-col p-8">
							<time class="text-xs font-medium text-muted" datetime={post.data.pubDate.toISOString()}>
								{formatDate(post.data.pubDate)}
							</time>
							<h3 class="mt-3 text-xl font-semibold leading-snug tracking-tight group-hover:text-accent">
								{post.data.title}
							</h3>
							<p class="mt-3 line-clamp-3 flex-1 text-sm leading-relaxed text-muted">{post.data.description}</p>
							<p class="link-blue mt-5 text-sm">阅读全文 →</p>
						</a>
					))
				}
			</div>
			<div class="reveal mt-10 text-center">
				<a href="/blog" class="link-blue text-sm">浏览全部文章 →</a>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	function jumpToPortfolioPage(page: number) {
		const viewer = document.querySelector<HTMLElement>('.portfolio-viewer');
		if (!viewer) return;
		viewer.scrollIntoView({ behavior: 'smooth', block: 'start' });
		viewer.dispatchEvent(new CustomEvent('portfolio:goto', { detail: { page } }));
	}

	document.querySelectorAll<HTMLAnchorElement>('[data-jump-page]').forEach((link) => {
		link.addEventListener('click', (e) => {
			const page = Number(link.dataset.jumpPage);
			if (!page) return;
			e.preventDefault();
			jumpToPortfolioPage(page);
		});
	});

	const params = new URLSearchParams(window.location.search);
	const pageFromQuery = Number(params.get('page'));
	// 仅在明确带 #portfolio 或从作品卡片跳转时才滚到作品集，避免打开首页就定位过去
	if (pageFromQuery && window.location.hash === '#portfolio') {
		requestAnimationFrame(() => jumpToPortfolioPage(pageFromQuery));
	}
</script>
