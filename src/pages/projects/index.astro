---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortfolioViewer from '../../components/portfolio/PortfolioViewer.astro';
import { portfolioProjects } from '../../data/portfolio';
---

<BaseLayout title="作品" description="王悦的作品集，站内完整浏览，无需跳转外站。">
	<section class="py-16 sm:py-24">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<p class="section-index reveal mb-5">Works · {portfolioProjects.length} Projects</p>
			<h1 class="display-title reveal text-5xl sm:text-6xl">作品集。</h1>
			<p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-muted">
				以下作品可在本页直接翻阅完整作品集，无需跳转外站。
			</p>

			<div class="mt-12 grid gap-5 sm:grid-cols-2">
				{
					portfolioProjects.map((project) => (
						<a
							href={`/?page=${project.startPage}#portfolio`}
							class="tile tile-hover group reveal block overflow-hidden"
							data-jump-page={project.startPage}
						>
							<img
								src={project.cover}
								alt={project.title}
								class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
								loading="lazy"
							/>
							<div class="p-7">
								<p class="text-xs font-semibold tracking-wider text-accent">
									{project.number} · {project.category}
								</p>
								<h2 class="mt-2 text-xl font-semibold tracking-tight">{project.title}</h2>
								<p class="mt-2 text-sm leading-relaxed text-muted">{project.summary}</p>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<PortfolioViewer />
</BaseLayout>

<script>
	document.querySelectorAll<HTMLAnchorElement>('[data-jump-page]').forEach((link) => {
		link.addEventListener('click', (e) => {
			const page = Number(link.dataset.jumpPage);
			if (!page) return;
			const viewer = document.querySelector<HTMLElement>('.portfolio-viewer');
			if (!viewer) return;
			e.preventDefault();
			viewer.scrollIntoView({ behavior: 'smooth', block: 'start' });
			viewer.dispatchEvent(new CustomEvent('portfolio:goto', { detail: { page } }));
		});
	});
</script>
